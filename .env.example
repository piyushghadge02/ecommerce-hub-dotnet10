# Copy to .env and adjust as needed. All values also work as plain
# environment variables (they take precedence over this file).
POSTGRES_DSN=postgresql+asyncpg://ecom:ecom@localhost:5432/ecommerce
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ecommerce
ELASTICSEARCH_URL=http://localhost:9200
ES_INDEX=orders

SYNC_STRATEGY=dual_write
OUTBOX_POLL_SECONDS=2
POLLING_INTERVAL_SECONDS=15
OUTBOX_MAX_ATTEMPTS=10
START_WORKERS=true

API_HOST=0.0.0.0
API_PORT=8000
